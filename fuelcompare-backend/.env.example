# Copie para .env e ajuste. Nenhum valor abaixo é uma credencial real.

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Identificação exigida/recomendada pelos provedores públicos (Overpass e Nominatim).
# Inclua um contato real ao implantar o serviço.
HTTP_USER_AGENT=FuelCompare/1.0 (projeto educacional; contato: dev@exemplo.com)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Limites e cache
NEARBY_CACHE_TTL_SECONDS=600
STATION_CACHE_TTL_SECONDS=1800
ANP_CACHE_TTL_SECONDS=21600
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=120
GEOCODE_RATE_LIMIT_MAX=30

# Produção: defina o proxy reverso e force HTTPS
TRUST_PROXY=false
ENFORCE_HTTPS=false

# CORS só é necessário se um cliente web consumir a API. Separe por vírgulas.
# CORS_ORIGINS=https://app.exemplo.com

# Opcional: URLs fixas do levantamento ANP. Se vazio, o backend descobre
# automaticamente os arquivos mais recentes na página oficial de dados abertos.
# ANP_REVENDAS_XLSX_URL=
# ANP_RESUMO_XLSX_URL=
# ANP_PRICE_PAGE_URL=https://www.gov.br/anp/pt-br/assuntos/precos-e-defesa-da-concorrencia/precos/levantamento-de-precos-de-combustiveis-ultimas-semanas-pesquisadas

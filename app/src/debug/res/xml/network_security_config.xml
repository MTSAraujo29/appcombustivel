<?xml version="1.0" encoding="utf-8"?>
<!-- Apenas no build de debug: permite HTTP para o backend local do emulador
     e para o PC de desenvolvimento na rede local. Ajuste/remova o IP abaixo
     se a rede mudar. O build de release continua exigindo HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.100.41</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
